{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
        "storageClass": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespaceOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "commonAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "replicaCount": { "const": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "updateStrategy": {
      "type": "object",
      "properties": { "type": { "const": "Recreate" } },
      "required": ["type"],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["registry", "repository", "tag", "digest", "pullPolicy", "pullSecrets"],
      "additionalProperties": false
    },
    "automountServiceAccountToken": { "type": "boolean" },
    "serviceAccountName": { "type": "string" },
    "hostAliases": { "type": "array" },
    "command": { "type": "array" },
    "args": { "type": "array" },
    "extraEnvVars": { "type": "array" },
    "extraEnvVarsConfigMap": { "type": "string" },
    "extraEnvVarsSecret": { "type": "string" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
    "containerSecurityContext": { "$ref": "#/definitions/containerSecurityContext" },
    "containerPorts": {
      "type": "object",
      "properties": { "http": { "type": "integer", "minimum": 1, "maximum": 65535 } },
      "required": ["http"],
      "additionalProperties": false
    },
    "service": { "$ref": "#/definitions/service" },
    "ingress": { "$ref": "#/definitions/ingress" },
    "persistence": { "$ref": "#/definitions/persistence" },
    "configMap": { "$ref": "#/definitions/configMap" },
    "config": { "type": "object" },
    "resources": { "type": "object" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "schedulerName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "dnsPolicy": { "type": "string" },
    "dnsConfig": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" }
  },
  "definitions": {
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "enum": ["Always", "OnRootMismatch"] },
        "seccompProfile": {
          "type": "object",
          "properties": { "type": { "enum": ["RuntimeDefault", "Localhost", "Unconfined"] } },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "capabilities": {
          "type": "object",
          "properties": { "drop": { "type": "array", "items": { "type": "string" } } },
          "additionalProperties": false
        },
        "seccompProfile": {
          "type": "object",
          "properties": { "type": { "enum": ["RuntimeDefault", "Localhost", "Unconfined"] } },
          "required": ["type"],
          "additionalProperties": false
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "ports": {
          "type": "object",
          "properties": { "http": { "type": "integer", "minimum": 1, "maximum": 65535 } },
          "required": ["http"],
          "additionalProperties": false
        },
        "nodePorts": {
          "type": "object",
          "properties": {
            "http": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "type": "string", "maxLength": 0 }] }
          },
          "required": ["http"],
          "additionalProperties": false
        },
        "clusterIP": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "enum": ["Cluster", "Local"] },
        "annotations": { "$ref": "#/definitions/labels" },
        "sessionAffinity": { "enum": ["None", "ClientIP"] }
      },
      "required": ["type", "ports", "nodePorts", "externalTrafficPolicy", "annotations", "sessionAffinity"],
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressClassName": { "type": "string" },
        "hostname": { "type": "string" },
        "path": { "type": "string" },
        "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
        "annotations": { "$ref": "#/definitions/labels" },
        "tls": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "extraHosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "pathType": { "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "extraPaths": { "type": "array" },
        "extraTls": { "type": "array" },
        "extraRules": { "type": "array" }
      },
      "required": ["enabled", "ingressClassName", "hostname", "path", "pathType", "annotations", "tls", "existingSecret", "extraHosts", "extraPaths", "extraTls", "extraRules"],
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "mountPath": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] } },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/labels" }
      },
      "required": ["enabled", "existingClaim", "mountPath", "storageClass", "accessModes", "size", "annotations"],
      "additionalProperties": false
    },
    "configMap": {
      "type": "object",
      "properties": { "annotations": { "$ref": "#/definitions/labels" } },
      "required": ["annotations"],
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      },
      "required": ["enabled", "path", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
      "additionalProperties": false
    }
  }
}
